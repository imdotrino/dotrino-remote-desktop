{
  "name": "@dotrino/remote-desktop-agent",
  "version": "0.6.0",
  "description": "Dotrino Remote Desktop: usa el escritorio de esta máquina desde los otros aparatos de tu cuenta. Lo dibuja a partir de su árbol de accesibilidad (ligero y nítido), cifrado punto a punto.",
  "type": "module",
  "bin": {
    "dotrino-remote-desktop-agent": "bin/cli.js"
  },
  "exports": {
    ".": "./index.js",
    "./scene": "./scene.js"
  },
  "files": [
    "index.js",
    "raise.js",
    "video.js",
    "atspi.js",
    "desktop.js",
    "scene.js",
    "link.js",
    "service.js",
    "bin",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node --test \"test/**/*.test.mjs\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@dotrino/identity": "0.139.0",
    "@dotrino/proxy-client": "0.49.1",
    "@dotrino/remote-agent": "0.39.2",
    "@dotrino/update": "0.9.4",
    "@dotrino/vault": "0.121.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imdotrino/dotrino-remote-desktop.git",
    "directory": "agent"
  },
  "homepage": "https://remote-desktop.dotrino.com/",
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@dotrino/webrtc": "0.1.0"
  }
}
